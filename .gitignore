go.work.sum

# ── Env / secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Data volumes (local compose) ────────────────────────────
deploy/compose/.data/
*.clickhouse
*.pgdata

# ── Editor / OS ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Coverage / logs ─────────────────────────────────────────
coverage/
*.log

# ── Playwright (E2E) ────────────────────────────────────────
playwright-report/
test-results/
e2e/.output/
e2e/screenshots/

