# Copy to `.env` (deploy/compose/.env is gitignored) and adjust.
# Used by docker-compose.prod.yml.

# ── Required ────────────────────────────────────────────────
# Session HMAC key — generate a long random string, e.g. `openssl rand -hex 32`.
RP_SESSION_SECRET=change-me-to-a-long-random-string

# ── URLs ────────────────────────────────────────────────────
# Where your BROWSER reaches the control plane (OAuth redirects etc.).
RP_PUBLIC_URL=http://localhost:8090
# Where your KUBERNETES CLUSTERS reach the control plane. Leave empty for a
# local/minikube trial; set it to a URL routable from inside the cluster before
# connecting a real remote cluster (e.g. https://rocketplane.your-domain.com).
RP_AGENT_CONTROLPLANE_URL=
# Where Beyla (in your cluster) ships OTLP traces/metrics. Leave empty to derive
# it from RP_AGENT_CONTROLPLANE_URL (same host, port 4318) — correct for this
# co-located stack. Set it only if your collector runs elsewhere.
RP_AGENT_OTLP_ENDPOINT=

# ── Image version ───────────────────────────────────────────
# `edge` tracks main. Pin a released version once one is tagged, e.g. RP_VERSION=v0.1.0
RP_VERSION=edge

# ── Data stores (defaults just work for a trial) ────────────
CLICKHOUSE_USER=rocketplane
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=otel
POSTGRES_USER=rocketplane
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rocketplane

# ── Optional: Google SSO (dev-login is used if unset) ───────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
